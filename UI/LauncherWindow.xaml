<Window x:Class="Launcher.UI.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Launcher" Width="768" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" Foreground="White">
  <Border x:Name="Shell" Margin="24,12,24,36" CornerRadius="18"
          Background="{DynamicResource IslandBg}" BorderBrush="#2EFFFFFF" BorderThickness="1"
          RenderTransformOrigin="0.5,0">
    <Border.Effect>
      <DropShadowEffect BlurRadius="32" ShadowDepth="10" Direction="270" Opacity="0.55" Color="Black"/>
    </Border.Effect>
    <Border.RenderTransform>
      <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1"/>
    </Border.RenderTransform>
    <StackPanel>
      <Grid Height="62" Margin="20,0,18,0">
        <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="19"
                   Foreground="{DynamicResource Dim}" VerticalAlignment="Center"/>
        <TextBlock x:Name="Placeholder" Margin="38,0,0,1" Text="Приложения, файлы, папки…" IsHitTestVisible="False"
                   FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="21" Foreground="{DynamicResource Dim}"
                   Opacity="0.75" VerticalAlignment="Center"/>
        <TextBox x:Name="Query" Margin="36,0,0,0" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="21"
                 Foreground="White" CaretBrush="{DynamicResource Accent}" SelectionBrush="{DynamicResource Accent}"
                 VerticalAlignment="Center" Background="Transparent" BorderThickness="0">
          <TextBox.Template>
            <ControlTemplate TargetType="TextBox">
              <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
            </ControlTemplate>
          </TextBox.Template>
        </TextBox>
      </Grid>
      <Border x:Name="Divider" Height="1" Background="#1AFFFFFF"/>
      <ScrollViewer x:Name="Scroll" MaxHeight="440" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                    Focusable="False" CanContentScroll="False">
        <StackPanel x:Name="List" Margin="8,6,8,6"/>
      </ScrollViewer>
      <Border x:Name="Footer" Height="34" Background="#0AFFFFFF" CornerRadius="0,0,17,17" BorderBrush="#14FFFFFF" BorderThickness="0,1,0,0">
        <Grid Margin="16,0">
          <TextBlock x:Name="Status" FontSize="12" Foreground="{DynamicResource Dim}" VerticalAlignment="Center"/>
          <TextBlock x:Name="Hints" FontSize="12" Foreground="{DynamicResource Dim}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </Grid>
      </Border>
    </StackPanel>
  </Border>
</Window>
