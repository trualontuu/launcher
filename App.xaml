<Application x:Class="Launcher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <!-- значения по умолчанию; ThemeSync заменяет их цветами темы Island -->
    <SolidColorBrush x:Key="IslandBg" Color="#000000"/>
    <SolidColorBrush x:Key="Card" Color="#1C1C1F"/>
    <SolidColorBrush x:Key="CardHover" Color="#2A2A2E"/>
    <SolidColorBrush x:Key="Accent" Color="#0A84FF"/>
    <SolidColorBrush x:Key="Dim" Color="#8E8E93"/>

    <Style TargetType="ContextMenu">
      <Setter Property="Background" Value="#1C1C1F"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#3A3A3E"/>
      <Setter Property="Padding" Value="4"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style TargetType="MenuItem">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Padding" Value="8,5"/>
    </Style>
  </Application.Resources>
</Application>
